rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isInstructor() {
      return request.auth != null
             && (
               request.auth.token.email == "jbanta@uttyler.edu"
               || request.auth.token.email == "gbouse2@uttyler.edu"
             );
    }

    match /limaBeanTouch_Fall2026/{submissionId} {

      // Authenticated students and the instructor may read the class data
      // so the live class analysis and instructor dashboard can function.
      allow read: if request.auth != null;

      // A student may create only a record owned by their anonymous account.
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;

      // A student may change only the record they originally created
      // and may not transfer ownership to another account.
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;

      // Students may delete their own records. The authenticated instructor
      // accounts may delete any submission for group or class resets.
      allow delete: if request.auth != null
                    && (
                      resource.data.ownerUid == request.auth.uid
                      || isInstructor()
                    );
    }
  }
}
